# Cloudflare Tunnel for the home arenas. Config: ~/.cloudflared/config.yml
[Unit]
Description=cloudflared tunnel (snek arenas)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cloudflared tunnel --no-autoupdate run
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
