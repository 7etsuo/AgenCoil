# Environment for arenas run on your own machine. Copy to
# ~/.config/agencoil/arena.env (chmod 600). Never commit the real file.
#
# Same database as the Vercel function, so profiles, the daily board and the
# arena registry are shared.
DATABASE_URL="postgres://..."
# Must equal the Vercel project's GAME_SECRET: resume tokens and /api/drain
# are signed with it and must verify on every arena.
GAME_SECRET="..."
# Turnstile: same values as the Vercel project. Leave the secret empty to run
# without the human check (local testing only).
TURNSTILE_SECRET_KEY="..."
TURNSTILE_ACTION="play"
TURNSTILE_HOSTNAMES="snek.grok.me,mmo.agenc.ag,agencoil.vercel.app,agencoil.grok.me,localhost,127.0.0.1"
NODE_ENV="production"
# Players this arena admits. The default (60) was measured against a Vercel
# Sandbox core; a desktop core holds several times that. The coordinator
# reads what each arena reports, so the Sandbox failover keeps its own cap.
ARENA_CAPACITY="150"
# Behind the Cloudflare tunnel the client address arrives in cf-connecting-ip.
# Only set this on a machine reached through the tunnel; anywhere else the
# header can be forged by the client.
TRUST_CF_CONNECTING_IP=1
